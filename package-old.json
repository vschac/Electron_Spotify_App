{
  "name": "electron-spotify-app",
  "version": "1.0.0",
  "description": "A Spotify app that allows you to add currently playing songs to playlists using hotkeys",
  "main": "src/main.js",
  "author": "Vince Schacknies",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac --arm64 --config.mac.target=dmg --config.mac.identity=null"
  },
  "build": {
    "appId": "com.vschac.electrotify",
    "productName": "Spotify Playlist Hotkey",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "axios": "^1.7.3",
    "dotenv": "^16.4.5",
    "querystring": "^0.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.5",
    "electron-builder": "^23.6.0"
  }
}
